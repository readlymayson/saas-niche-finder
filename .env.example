# Скопируйте в `.env` и заполните секреты.

# PostgreSQL (локально или docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/niche_finder

# Redis (Celery broker/backend)
REDIS_URL=redis://localhost:6379/0

# Статический токен API (X-Api-Token или Authorization: Bearer)
# Сгенерируйте: openssl rand -hex 32
API_TOKEN=change-me-please-generate-a-secret-token

# Telegram scraper (Telethon) — https://my.telegram.org/apps
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_PHONE=
# Путь к файлу сессии Telethon (.session) внутри контейнера.
# Файл монтируется из backend/sessions (volume в docker-compose.yml).
# Альтернатива: TELEGRAM_SESSION_STRING=<session string> (без файла).
# TELEGRAM_SESSION_PATH=/app/sessions/telegram.session

# Яндекс Wordstat (Yandex Search API v2) — https://aistudio.yandex.ru/docs/ru/search-api/concepts/wordstat
# API-ключ сервисного аккаунта (роль search-api.webSearch.user, область yc.search-api.execute)
# или IAM-токен. Ключи AQVN.../t1... считаются IAM, остальные — Api-key.
# WORDSTAT_API_KEY=
# WORDSTAT_API_URL=https://searchapi.api.cloud.yandex.net/v2/wordstat
# Каталог для Wordstat (если не задан — берётся YANDEX_GPT_FOLDER_ID)
# WORDSTAT_FOLDER_ID=
# WORDSTAT_REGION=213
# WORDSTAT_PERIOD=PERIOD_MONTHLY
# Окно динамики для тренда (дней): 400 → месяц год назад от последней точки
# WORDSTAT_TREND_DAYS=400

# YandexGPT (Foundation Models) — https://console.cloud.yandex.ru
# YANDEX_GPT_API_KEY=
# YANDEX_GPT_FOLDER_ID=
# YANDEX_GPT_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion
# YANDEX_GPT_MODEL_URI=
