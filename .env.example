# Скопируйте в `.env` и заполните секреты.

# PostgreSQL (локально или docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/niche_finder

# Redis (Celery broker/backend)
REDIS_URL=redis://localhost:6379/0

# JWT — в продакшене сгенерируйте: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Опционально
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Telegram (Telethon, user account) — my.telegram.org
# TELEGRAM_API_ID=12345678
# TELEGRAM_API_HASH=hexstring
# TELEGRAM_SESSION_PATH=.data/telegram.session
# Либо строка сессии (StringSession), если не используете файл:
# TELEGRAM_SESSION_STRING=

# Лимиты (по умолчанию совпадают с планом)
# TELEGRAM_MAX_MESSAGES_PER_MINUTE=30
# TELETHON_FLOOD_SLEEP_THRESHOLD=60

# Docker: ML (отдельный образ с torch), профиль ml; каталог backend/ml монтируется в контейнер
# docker compose --profile ml run --rm ml-train python ml/build_demo_dataset.py
# docker compose --profile ml run --rm ml-train
# При смене только кода ml пересборка не нужна; после правок pyproject — docker compose build ml-train

# --- Неделя 3: Яндекс.Директ (Вордстат) + YandexGPT ---
# OAuth-токен приложения с доступом к API Директа владельца
# YANDEX_DIRECT_OAUTH_TOKEN=
# Опционально (агентский/клиентский логин)
# YANDEX_DIRECT_CLIENT_LOGIN=

# YandexGPT Foundation Models (облако)
# YANDEX_GPT_API_KEY=
# YANDEX_GPT_FOLDER_ID=
# Опционально полный modelUri:
# YANDEX_GPT_MODEL_URI=gpt://<folder_id>/yandexgpt/latest
