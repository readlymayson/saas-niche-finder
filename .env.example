# Скопируйте в `.env` и заполните секреты.

# PostgreSQL (локально или docker-compose)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/niche_finder

# Redis (Celery broker/backend + rate limiting)
REDIS_URL=redis://localhost:6379/0

# JWT — в продакшене сгенерируйте: openssl rand -hex 32
JWT_SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Опционально
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# DaaS — тарифы (запросов в минуту)
RATE_LIMIT_FREE=10
RATE_LIMIT_DEVELOPER=300
RATE_LIMIT_ENTERPRISE=3000

# ЮKassa (для биллинга)
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=

# Telegram scraper (Telethon) — https://my.telegram.org/apps
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=
TELEGRAM_PHONE=

# Яндекс.Директ / Wordstat API — https://yandex.ru/direct
YANDEX_DIRECT_TOKEN=
YANDEX_DIRECT_LOGIN=
